{
  "name": "giftme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --port 3200",
    "build": "tsr generate && tsc --noEmit && vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsr generate && tsc --noEmit",
    "blnk:init": "node scripts/init-blnk.mjs",
    "blnk:up": "docker compose -f blnk/docker-compose.yml up -d",
    "blnk:down": "docker compose -f blnk/docker-compose.yml down",
    "tunnel": "ngrok http 3200"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "0.27.17",
    "@libsql/client": "^0.17.0",
    "@tanstack/react-router": "1.132.31",
    "@tanstack/react-start": "1.132.32",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@tanstack/nitro-v2-vite-plugin": "1.132.40",
    "@tanstack/router-cli": "1.132.31",
    "@tanstack/router-plugin": "1.132.31",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "5.1.4"
  }
}
