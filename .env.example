# Copy to .env and fill in. See README.md for where each value comes from.

# Where the site is reachable: http://localhost:3200 locally, your ngrok URL while
# testing webhooks, the real domain in production. Used for Paystack callbacks and share links.
PUBLIC_SITE_URL=http://localhost:3200

# App database (libsql): a local file, or libsql://... (Turso) in production.
DATABASE_URL=file:giftme.db
DATABASE_AUTH_TOKEN=

# GiftMe's own Blnk Core (blnk/docker-compose.yml, API on port 5201).
# BLNK_SECRET_KEY must equal server.secret_key in blnk/blnk.json; `npm run blnk:init` sets both.
BLNK_URL=http://localhost:5201
BLNK_SECRET_KEY=

# Paystack secret key. Use sk_test_... locally. Each owner gets a Paystack subaccount.
PAYSTACK_SECRET_KEY=

# Clerk (Google + email code sign-in, hosted UI). Leave both empty to use the local test
# sign-in, which only works when NODE_ENV is not production.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: signs the local test sign-in cookie.
DEV_AUTH_SECRET=

# Optional: product search (SerpApi Google Shopping, Nigeria). Without it, search is hidden
# and link pasting still works.
SERPAPI_KEY=

# Naira per US dollar, for prices given in dollars.
USD_NGN_RATE=1500

# Optional GiftMe fee per gift, in percent (kept by GiftMe's main Paystack account). Default 0.
PLATFORM_FEE_PERCENT=0

# Optional: email (new-gift alerts to owners, thank-you notes to guests) through Resend.
# Without these, emails are printed in the server log instead.
RESEND_API_KEY=
# Quote it. onboarding@resend.dev works before you verify a domain (delivers to your own address only).
EMAIL_FROM="GiftMe <onboarding@resend.dev>"

# Optional: public link to the source code, shown on the landing page.
VITE_REPO_URL=

# Optional: where uploaded and copied images are stored (local image store). Default: uploads
UPLOAD_DIR=uploads

# Emails (comma separated) that can open the private /dashboard/admin numbers page.
ADMIN_EMAILS=
